---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/manage.css';
---
<BaseLayout
  title="관리자 - RoboSEasy"
  description="로보시지 관리자 페이지"
  path="/manage"
  lockTheme="light"
>
  <meta name="robots" content="noindex" slot="head" />

  <main class="adm">
    <div id="loading" class="adm__loading">권한 확인 중...</div>

    <div id="content" hidden>
      <div class="adm__top">
        <h1 class="adm__title">관리자</h1>
        <div class="adm__seg" role="tablist">
          <button type="button" class="adm__seg-btn is-active" data-panel="contacts">문의 <span id="seg-ct"></span></button>
          <button type="button" class="adm__seg-btn" data-panel="users">유저 <span id="seg-us"></span></button>
          <button type="button" class="adm__seg-btn" data-panel="orders">주문 <span id="seg-or"></span></button>
        </div>
        <button type="button" id="logoutBtn" class="adm__logout">로그아웃</button>
      </div>

      <!-- 문의 관리 — 목록 + 상세 분할 뷰 -->
      <section class="adm__panel is-active" data-panel="contacts">
        <div class="adm__split">
          <div class="adm__list-card">
            <div class="adm__filters">
              <div class="adm__search-box">
                <input id="ct-search" class="adm__search" type="search" placeholder="이름·이메일 검색" aria-label="문의 검색" />
                <button type="button" id="ct-searchBtn" class="adm__search-btn">검색</button>
              </div>
              <select id="f-status" class="adm__select">
                <option value="">상태 전체</option>
                <option value="RECEIVED">접수됨</option>
                <option value="IN_PROGRESS">처리 중</option>
                <option value="DONE">완료</option>
              </select>
              <select id="f-channel" class="adm__select">
                <option value="">채널 전체</option>
                <option value="b2b">B2B</option>
                <option value="b2c">B2C</option>
              </select>
              <select id="f-dispute" class="adm__select">
                <option value="">분쟁 전체</option>
                <option value="true">분쟁만</option>
                <option value="false">일반만</option>
              </select>
            </div>
            <div id="contactList" class="adm__list-scroll"></div>
            <div id="contactsEmpty" class="adm__empty" hidden>문의가 없습니다.</div>
            <div class="adm__pager">
              <button type="button" id="ct-prev">이전</button>
              <span id="ct-page">1</span>
              <button type="button" id="ct-next">다음</button>
              <span class="adm__pager-total" id="ct-total"></span>
            </div>
          </div>

          <div class="adm__detail">
            <p id="detailPlaceholder" class="adm__placeholder">문의를 선택하세요.</p>
            <div id="detailBody" class="adm__detail-body" hidden>
              <div class="adm__detail-head">
                <h2 class="adm__detail-title" id="d-title"></h2>
                <span class="adm__badge" id="d-channel"></span>
                <span class="adm__badge" id="d-status"></span>
                <span class="adm__detail-date" id="d-date"></span>
              </div>
              <div class="adm__detail-contact">
                <span><b>이름</b><span id="d-name"></span></span>
                <span><b>이메일</b><span id="d-email"></span></span>
                <span><b>전화</b><span id="d-phone"></span></span>
                <span id="d-orderWrap" hidden><b>연계 주문</b><button type="button" id="d-order" class="adm__order-link"></button></span>
              </div>
              <p class="adm__detail-msg" id="d-msg"></p>
              <div class="adm__detail-actions">
                <label>상태
                  <select id="d-statusSel" class="adm__select">
                    <option value="RECEIVED">접수됨</option>
                    <option value="IN_PROGRESS">처리 중</option>
                    <option value="DONE">완료</option>
                  </select>
                </label>
                <label><input type="checkbox" id="d-dispute" /> 분쟁 (기록 3년 보관)</label>
                <button type="button" id="d-done" class="adm__done-btn">완료로 표시</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 유저 -->
      <section class="adm__panel" data-panel="users">
        <div class="adm__toolbar">
          <div class="adm__search-box">
            <input id="us-search" class="adm__search" type="search" placeholder="이름·이메일 검색" aria-label="유저 검색" />
            <button type="button" id="us-searchBtn" class="adm__search-btn">검색</button>
          </div>
        </div>
        <div class="adm__table-wrap">
          <table class="adm__table">
            <thead>
              <tr><th>가입일</th><th>이메일</th><th>이름</th><th>전화번호</th><th>주소</th><th>마케팅</th><th>권한</th></tr>
            </thead>
            <tbody id="usersBody"></tbody>
          </table>
          <div id="usersEmpty" class="adm__empty" hidden>유저가 없습니다.</div>
          <div class="adm__pager adm__table-pager">
            <button type="button" id="us-prev">이전</button>
            <span id="us-page">1</span>
            <button type="button" id="us-next">다음</button>
            <span class="adm__pager-total" id="us-total"></span>
          </div>
        </div>
      </section>

      <!-- 주문 -->
      <section class="adm__panel" data-panel="orders">
        <div class="adm__toolbar">
          <div class="adm__search-box">
            <input id="or-search" class="adm__search" type="search" placeholder="수령인·주문번호·주문자 이메일 검색" aria-label="주문 검색" />
            <button type="button" id="or-searchBtn" class="adm__search-btn">검색</button>
          </div>
        </div>
        <div class="adm__table-wrap">
          <table class="adm__table">
            <thead>
              <tr><th>주문일</th><th>주문번호</th><th>금액</th><th>수령인</th><th>전화번호</th><th>배송지</th><th>상태</th><th>배송 관리</th></tr>
            </thead>
            <tbody id="ordersBody"></tbody>
          </table>
          <div id="ordersEmpty" class="adm__empty" hidden>주문이 없습니다.</div>
          <div class="adm__pager adm__table-pager">
            <button type="button" id="or-prev">이전</button>
            <span id="or-page">1</span>
            <button type="button" id="or-next">다음</button>
            <span class="adm__pager-total" id="or-total"></span>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { $ } from '../lib/dom';
  import { ORDER_STATUS_LABEL } from '../data/orderStatus';

  /* ── 권한 확인 ── */
  async function guard() {
    const res = await fetch('/api/v1/users/me');
    if (res.status === 401) { location.href = '/login?redirect=/manage'; return false; }
    const me = res.ok ? await res.json() : null;
    if (!me || me.role !== 'admin') { location.href = '/'; return false; }
    return true;
  }

  /* ── 세그먼트 패널 전환 ── */
  const segBtns = document.querySelectorAll<HTMLButtonElement>('.adm__seg-btn');
  const panels = document.querySelectorAll<HTMLElement>('.adm__panel');
  segBtns.forEach((t) =>
    t.addEventListener('click', () => {
      segBtns.forEach((x) => x.classList.toggle('is-active', x === t));
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === t.dataset.panel));
    })
  );

  const fmtDate = (s: string) => new Date(s).toLocaleDateString('ko-KR');
  const td = (text: string, cls = '') => {
    const el = document.createElement('td');
    if (cls) el.className = cls;
    el.textContent = text;
    return el;
  };
  const searchQuery = (id: string) => ($(id) as HTMLInputElement).value.trim();
  // 검색 실행은 Enter·검색 버튼으로만 — 타이핑마다 조회하지 않는다(ilike 질의 부하)
  const onSearch = (inputId: string, btnId: string, run: () => void) => {
    $(inputId).addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') run();
    });
    $(btnId).addEventListener('click', run);
  };

  /* ── 문의 관리 — 목록 + 상세 ── */
  const CT_TYPE: Record<string, string> = {
    purchase: '로봇 구매', as: 'AS', workshop: '워크샵', corp_edu: '교육', etc: '기타',
    product: '제품', delivery: '배송', refund: '환불·취소',
  };
  const CT_STATUS: Record<string, { text: string; cls: string }> = {
    RECEIVED: { text: '접수됨', cls: 'adm__badge--new' },
    IN_PROGRESS: { text: '처리 중', cls: 'adm__badge--progress' },
    DONE: { text: '완료', cls: 'adm__badge--done' },
  };

  type Contact = {
    contactId: string; createdAt: string; channel: string; contactType: string;
    name: string; email: string; phone: string; message: string; orderId: string | null;
    isDispute: boolean; status: string;
  };
  let contacts: Contact[] = [];
  let ctPage = 1;
  let selectedId: string | null = null;

  function statusBadge(el: HTMLElement, status: string) {
    const st = CT_STATUS[status] ?? { text: status, cls: '' };
    el.className = `adm__badge ${st.cls}`;
    el.textContent = st.text;
  }

  function renderContactList() {
    const list = $('contactList');
    list.innerHTML = '';
    $('contactsEmpty').hidden = contacts.length > 0;

    for (const q of contacts) {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = `adm__item${q.contactId === selectedId ? ' is-active' : ''}`;

      const row = document.createElement('span');
      row.className = 'adm__item-row';
      const ch = document.createElement('span');
      ch.className = `adm__badge${q.channel === 'b2c' ? ' adm__badge--b2c' : ''}`;
      ch.textContent = q.channel.toUpperCase();
      const name = document.createElement('span');
      name.className = 'adm__item-name';
      name.textContent = `${q.name} · ${CT_TYPE[q.contactType] ?? q.contactType}`;
      row.append(ch, name);
      const st = document.createElement('span');
      statusBadge(st, q.status);
      row.append(st);
      if (q.isDispute) {
        const d = document.createElement('span');
        d.className = 'adm__badge adm__badge--dispute';
        d.textContent = '분쟁';
        row.append(d);
      }
      const date = document.createElement('span');
      date.className = 'adm__item-date';
      date.textContent = fmtDate(q.createdAt);
      row.append(date);

      const snippet = document.createElement('span');
      snippet.className = 'adm__item-snippet';
      snippet.textContent = q.message;

      item.append(row, snippet);
      item.addEventListener('click', () => selectContact(q.contactId));
      list.appendChild(item);
    }
  }

  function selectContact(id: string | null) {
    selectedId = id;
    const q = contacts.find((x) => x.contactId === id);
    $('detailPlaceholder').hidden = !!q;
    ($('detailBody') as HTMLElement).hidden = !q;
    document.querySelectorAll<HTMLElement>('.adm__item').forEach((el, i) =>
      el.classList.toggle('is-active', contacts[i]?.contactId === id)
    );
    if (!q) return;

    $('d-title').textContent = `${CT_TYPE[q.contactType] ?? q.contactType} 문의`;
    const ch = $('d-channel');
    ch.className = `adm__badge${q.channel === 'b2c' ? ' adm__badge--b2c' : ''}`;
    ch.textContent = q.channel.toUpperCase();
    statusBadge($('d-status'), q.status);
    $('d-date').textContent = `${fmtDate(q.createdAt)} 접수`;
    $('d-name').textContent = q.name;
    $('d-email').textContent = q.email;
    $('d-phone').textContent = q.phone || '-';
    ($('d-orderWrap') as HTMLElement).hidden = !q.orderId;
    $('d-order').textContent = q.orderId ? q.orderId.slice(0, 8) : '';
    $('d-msg').textContent = q.message;
    ($('d-statusSel') as HTMLSelectElement).value = q.status;
    ($('d-dispute') as HTMLInputElement).checked = q.isDispute;
    ($('d-done') as HTMLButtonElement).disabled = q.status === 'DONE';
  }

  async function loadContacts() {
    const params = new URLSearchParams({ page: String(ctPage) });
    const channel = ($('f-channel') as HTMLSelectElement).value;
    const status = ($('f-status') as HTMLSelectElement).value;
    const dispute = ($('f-dispute') as HTMLSelectElement).value;
    if (channel) params.set('channel', channel);
    if (status) params.set('status', status);
    if (dispute) params.set('is_dispute', dispute);
    const q = searchQuery('ct-search');
    if (q) params.set('q', q);

    const res = await fetch(`/api/v1/admin/contacts?${params}`);
    if (!res.ok) return;
    const { contacts: rows, total, pageSize } = await res.json();
    contacts = rows;

    $('seg-ct').textContent = String(total);
    $('ct-total').textContent = `총 ${total}건`;
    $('ct-page').textContent = String(ctPage);
    ($('ct-prev') as HTMLButtonElement).disabled = ctPage <= 1;
    ($('ct-next') as HTMLButtonElement).disabled = ctPage * (pageSize ?? 10) >= total;

    // 선택 유지 — 현재 페이지에 없으면 첫 항목 선택
    if (!contacts.some((q) => q.contactId === selectedId)) {
      selectedId = contacts[0]?.contactId ?? null;
    }
    renderContactList();
    selectContact(selectedId);
  }

  async function patchContact(id: string, patch: object, el: HTMLInputElement | HTMLSelectElement | HTMLButtonElement) {
    el.disabled = true;
    try {
      const res = await fetch(`/api/v1/admin/contacts/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(patch),
      });
      if (!res.ok) { alert('변경에 실패했습니다.'); return false; }
      return true;
    } catch {
      alert('네트워크 오류가 발생했습니다.');
      return false;
    } finally {
      el.disabled = false;
    }
  }

  /* 상세 패널 처리 컨트롤 — 성공 시 로컬 상태·목록·배지 갱신 */
  $('d-statusSel').addEventListener('change', async () => {
    const q = contacts.find((x) => x.contactId === selectedId);
    if (!q) return;
    const sel = $('d-statusSel') as HTMLSelectElement;
    const prev = q.status;
    if (await patchContact(q.contactId, { status: sel.value }, sel)) {
      q.status = sel.value;
    } else {
      sel.value = prev;
    }
    renderContactList();
    selectContact(q.contactId);
  });

  $('d-dispute').addEventListener('change', async () => {
    const q = contacts.find((x) => x.contactId === selectedId);
    if (!q) return;
    const chk = $('d-dispute') as HTMLInputElement;
    if (await patchContact(q.contactId, { isDispute: chk.checked }, chk)) {
      q.isDispute = chk.checked;
    } else {
      chk.checked = q.isDispute;
    }
    renderContactList();
    selectContact(q.contactId);
  });

  $('d-done').addEventListener('click', async () => {
    const q = contacts.find((x) => x.contactId === selectedId);
    if (!q) return;
    const btn = $('d-done') as HTMLButtonElement;
    if (await patchContact(q.contactId, { status: 'DONE' }, btn)) {
      q.status = 'DONE';
    }
    renderContactList();
    selectContact(q.contactId);
  });

  // 연계 주문으로 이동 — 주문 탭 전환 + 주문번호 프리픽스 검색 (환불 문의 → 해당 주문 환불 처리 동선)
  $('d-order').addEventListener('click', () => {
    const q = contacts.find((x) => x.contactId === selectedId);
    if (!q?.orderId) return;
    ($('or-search') as HTMLInputElement).value = q.orderId.slice(0, 8);
    orPage = 1;
    loadOrders();
    (document.querySelector('.adm__seg-btn[data-panel="orders"]') as HTMLButtonElement)?.click();
  });

  ['f-channel', 'f-status', 'f-dispute'].forEach((id) =>
    $(id).addEventListener('change', () => { ctPage = 1; loadContacts(); })
  );
  onSearch('ct-search', 'ct-searchBtn', () => { ctPage = 1; loadContacts(); });
  $('ct-prev').addEventListener('click', () => { ctPage--; loadContacts(); });
  $('ct-next').addEventListener('click', () => { ctPage++; loadContacts(); });

  /* ── 유저 ── */
  let usPage = 1;
  async function loadUsers() {
    const params = new URLSearchParams({ page: String(usPage) });
    const q = searchQuery('us-search');
    if (q) params.set('q', q);
    const res = await fetch(`/api/v1/admin/users?${params}`);
    if (!res.ok) return;
    const { users, total, pageSize } = await res.json();
    const body = $('usersBody');
    body.innerHTML = '';
    $('usersEmpty').hidden = users.length > 0;
    $('seg-us').textContent = String(total);
    $('us-total').textContent = `총 ${total}명`;
    $('us-page').textContent = String(usPage);
    ($('us-prev') as HTMLButtonElement).disabled = usPage <= 1;
    ($('us-next') as HTMLButtonElement).disabled = usPage * (pageSize ?? 30) >= total;

    for (const u of users) {
      const tr = document.createElement('tr');
      tr.append(
        td(fmtDate(u.createdAt), 'adm__nowrap'),
        td(u.email, 'adm__nowrap'),
        td(u.name, 'adm__nowrap'),
        td(u.phone, 'adm__nowrap'),
        td([u.postcode && `(${u.postcode})`, u.address, u.addressDetail].filter(Boolean).join(' ')),
        td(u.marketingConsent ? '동의' : '-', 'adm__nowrap'),
        td(u.role, 'adm__nowrap'),
      );
      body.appendChild(tr);
    }
  }
  onSearch('us-search', 'us-searchBtn', () => { usPage = 1; loadUsers(); });
  $('us-prev').addEventListener('click', () => { usPage--; loadUsers(); });
  $('us-next').addEventListener('click', () => { usPage++; loadUsers(); });

  /* ── 주문 ── */
  let orPage = 1;
  async function loadOrders() {
    const params = new URLSearchParams({ page: String(orPage) });
    const q = searchQuery('or-search');
    if (q) params.set('q', q);
    const res = await fetch(`/api/v1/admin/orders?${params}`);
    if (!res.ok) return;
    const { orders, total, pageSize } = await res.json();
    const body = $('ordersBody');
    body.innerHTML = '';
    $('ordersEmpty').hidden = orders.length > 0;
    $('seg-or').textContent = String(total);
    $('or-total').textContent = `총 ${total}건`;
    $('or-page').textContent = String(orPage);
    ($('or-prev') as HTMLButtonElement).disabled = orPage <= 1;
    ($('or-next') as HTMLButtonElement).disabled = orPage * (pageSize ?? 30) >= total;
    for (const o of orders) {
      const tr = document.createElement('tr');
      tr.append(
        td(fmtDate(o.createdAt), 'adm__nowrap'),
        td(o.orderId.slice(0, 8), 'adm__nowrap'),
        td(Number(o.totalPrice).toLocaleString('ko-KR') + '원', 'adm__nowrap'),
        td(o.receiverName, 'adm__nowrap'),
        td(o.receiverPhone ?? '-', 'adm__nowrap'),
        td([o.shippingPostcode && `(${o.shippingPostcode})`, o.shippingAddress, o.shippingAddressDetail].filter(Boolean).join(' ')),
        td(ORDER_STATUS_LABEL[o.status] ?? o.status, 'adm__nowrap'),
        deliveryCell(o),
      );
      body.appendChild(tr);
    }
  }
  onSearch('or-search', 'or-searchBtn', () => { orPage = 1; loadOrders(); });
  $('or-prev').addEventListener('click', () => { orPage--; loadOrders(); });
  $('or-next').addEventListener('click', () => { orPage++; loadOrders(); });

  /* 배송·환불 관리 셀 — PAID: 배송 시작 / SHIPPING: 배송 완료 / DELIVERED: 환불 접수 /
     REFUND_REQUESTED: 환불 승인·거절 (전이 규칙은 서버 검증) */
  function deliveryCell(o: {
    orderId: string; status: string; courier: string | null; trackingNumber: string | null;
    totalPrice: number | string; refundAmount: number | null;
  }) {
    const cell = document.createElement('td');
    cell.className = 'adm__nowrap';

    const patch = async (payload: object, btn: HTMLButtonElement, path = 'delivery') => {
      btn.disabled = true;
      try {
        const res = await fetch(`/api/v1/admin/orders/${o.orderId}/${path}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => null);
        if (!res.ok) { alert(json?.error ?? '변경에 실패했습니다.'); btn.disabled = false; return; }
        await loadOrders(); // 성공 시 행이 새로 그려져 이 버튼은 교체됨
        if (btn.isConnected) btn.disabled = false; // 재조회가 실패해 재렌더 안 된 경우만 복구
      } catch {
        alert('네트워크 오류가 발생했습니다.');
        btn.disabled = false;
      }
    };

    if (o.status === 'PAID') {
      // 로젠택배 단독 계약 — 운송장 번호만 입력, 택배사는 서버가 자동 세팅
      const tracking = document.createElement('input');
      tracking.className = 'adm__delivery-input';
      tracking.placeholder = '운송장 번호';
      tracking.value = o.trackingNumber ?? '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'adm__delivery-btn';
      btn.textContent = '배송 시작';
      btn.addEventListener('click', () => {
        if (!tracking.value.trim()) { alert('운송장 번호를 입력해 주세요.'); return; }
        patch({ status: 'SHIPPING', trackingNumber: tracking.value.trim() }, btn);
      });
      cell.append(tracking, btn);
    } else if (o.status === 'SHIPPING') {
      // 운송장 오기입 정정 — 수정 버튼을 누르면 입력칸으로 바뀌고, 저장 시 상태 전이 없이 번호만 갱신
      const info = document.createElement('span');
      info.className = 'adm__delivery-info';
      info.textContent = `${o.courier ?? ''} ${o.trackingNumber ?? ''}`.trim();

      const editBtn = document.createElement('button');
      editBtn.type = 'button';
      editBtn.className = 'adm__delivery-btn';
      editBtn.textContent = '배송 수정';

      const doneBtn = document.createElement('button');
      doneBtn.type = 'button';
      doneBtn.className = 'adm__delivery-btn';
      doneBtn.textContent = '배송 완료';
      doneBtn.addEventListener('click', () => patch({ status: 'DELIVERED' }, doneBtn));

      editBtn.addEventListener('click', () => {
        // 취소·무변경은 이 셀만 원래 3버튼으로 되돌린다 — 전체 목록 재조회(loadOrders) 불필요
        const restore = () => cell.replaceChildren(info, editBtn, doneBtn);
        const tracking = document.createElement('input');
        tracking.className = 'adm__delivery-input';
        tracking.placeholder = '운송장 번호';
        tracking.value = o.trackingNumber ?? '';
        const saveBtn = document.createElement('button');
        saveBtn.type = 'button';
        saveBtn.className = 'adm__delivery-btn';
        saveBtn.textContent = '저장';
        saveBtn.addEventListener('click', () => {
          const next = tracking.value.trim();
          if (!next) { alert('운송장 번호를 입력해 주세요.'); return; }
          if (next === o.trackingNumber) { restore(); return; } // 변경 없음 — 원래 표시로 복귀
          patch({ trackingNumber: next }, saveBtn);
        });
        const cancelBtn = document.createElement('button');
        cancelBtn.type = 'button';
        cancelBtn.className = 'adm__delivery-btn';
        cancelBtn.textContent = '취소';
        cancelBtn.addEventListener('click', restore);
        cell.replaceChildren(tracking, saveBtn, cancelBtn);
        tracking.focus();
      });

      cell.append(info, editBtn, doneBtn);
    } else if (o.status === 'DELIVERED') {
      // 환불 문의 확인 후 여기서 접수 — REQUEST 전이(반품 회수·검수 대기), 승인 전까지 돈은 안 움직임
      if (o.trackingNumber) {
        const info = document.createElement('span');
        info.className = 'adm__delivery-info';
        info.textContent = `${o.courier ?? ''} ${o.trackingNumber}`.trim();
        cell.appendChild(info);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'adm__delivery-btn';
      btn.textContent = '환불 접수';
      btn.addEventListener('click', () => {
        const reason = prompt('환불 사유 (환불 문의 내용 요약, 200자 이내)');
        if (reason === null) return;
        if (!reason.trim()) { alert('환불 사유를 입력해 주세요.'); return; }
        patch({ action: 'REQUEST', reason: reason.trim() }, btn, 'refund');
      });
      cell.appendChild(btn);
    } else if (o.status === 'REFUND_REQUESTED') {
      const total = Number(o.totalPrice);
      const approveBtn = document.createElement('button');
      approveBtn.type = 'button';
      approveBtn.className = 'adm__delivery-btn';
      approveBtn.textContent = '환불 승인';
      approveBtn.addEventListener('click', () => {
        const v = prompt('환불 금액(원) — 반품비 차감 시 수정', String(total));
        if (v === null) return;
        const amount = Number(v.replace(/[^\d]/g, ''));
        if (!amount || amount > total) { alert(`환불 금액이 올바르지 않습니다. (1 ~ ${total.toLocaleString('ko-KR')}원)`); return; }
        if (!confirm(`${amount.toLocaleString('ko-KR')}원을 환불(토스 결제 취소)합니다. 진행할까요?`)) return;
        patch({ action: 'APPROVE', refundAmount: amount }, approveBtn, 'refund');
      });
      const rejectBtn = document.createElement('button');
      rejectBtn.type = 'button';
      rejectBtn.className = 'adm__delivery-btn';
      rejectBtn.textContent = '거절';
      rejectBtn.addEventListener('click', () => {
        if (!confirm('환불 접수를 거절하고 배송 완료 상태로 되돌릴까요? (사유는 이메일로 안내해 주세요)')) return;
        patch({ action: 'REJECT' }, rejectBtn, 'refund');
      });
      cell.append(approveBtn, rejectBtn);
    } else if (o.status === 'REFUNDED') {
      cell.textContent = o.refundAmount != null ? `환불 ${Number(o.refundAmount).toLocaleString('ko-KR')}원` : '환불 완료';
    } else if (o.trackingNumber) {
      cell.textContent = `${o.courier ?? ''} ${o.trackingNumber}`.trim();
    } else {
      cell.textContent = '—';
    }
    return cell;
  }

  /* ── 로그아웃 ── */
  $('logoutBtn').addEventListener('click', async () => {
    await fetch('/api/v1/users/logout', { method: 'POST' });
    location.href = '/login';
  });

  /* ── 초기화 ── */
  (async () => {
    // 목록 로드를 권한 확인과 병렬로 시작 — 비관리자는 401/403으로 조용히 실패하고 곧 리다이렉트됨
    loadContacts();
    loadUsers();
    loadOrders();
    if (!(await guard())) return;
    $('loading').style.display = 'none';
    ($('content') as HTMLElement).hidden = false;
  })();
</script>
