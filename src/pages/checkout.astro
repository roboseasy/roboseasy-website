---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/checkout.css';
---
<BaseLayout
  title="주문서 - RoboSEasy | 로보시지"
  description="로보시지 주문서"
  path="/checkout"
  lockTheme="light"
  shopNav
>
  <meta name="robots" content="noindex" slot="head" />
  <!-- 카카오(다음) 우편번호 서비스 — 키·과금 없음 -->
  <script is:inline src="https://t1.kakaocdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js" defer slot="head"></script>
  <!-- 토스페이먼츠 결제위젯 v2 -->
  <script is:inline src="https://js.tosspayments.com/v2/standard" slot="head"></script>

  <main class="checkout">
    <h1 class="checkout__title">주문서</h1>
    <div id="loading" class="checkout__loading">불러오는 중...</div>
    <div id="pageMsg" class="checkout__msg" role="alert" hidden></div>

    <div id="content" hidden>
      <div class="checkout__grid">
        <div class="checkout__main">
          <!-- 주문 상품 -->
          <section class="checkout__section" aria-label="주문 상품">
            <h2 class="checkout__section-title">주문 상품</h2>
            <ul id="itemList" class="checkout__items"></ul>
          </section>

          <!-- 배송지 -->
          <section class="checkout__section" aria-label="배송지">
            <h2 class="checkout__section-title">배송지</h2>
            <div class="checkout__form">
              <div class="checkout__field-row">
                <input id="f-name" class="checkout__input" type="text" placeholder="수령인" autocomplete="name" aria-label="수령인" />
                <input id="f-phone" class="checkout__input" type="tel" placeholder="연락처" autocomplete="tel" aria-label="연락처" />
              </div>
              <div class="checkout__field-row checkout__field-row--zip">
                <input id="f-postcode" class="checkout__input checkout__input--zip" type="text" placeholder="우편번호" readonly aria-label="우편번호" />
                <button type="button" id="zipBtn" class="checkout__zip-btn">주소 검색</button>
              </div>
              <input id="f-address" class="checkout__input" type="text" placeholder="기본 주소 — 주소 검색으로 입력" readonly aria-label="기본 주소" />
              <input id="f-addressDetail" class="checkout__input" type="text" placeholder="상세 주소 (동·호수 등)" autocomplete="address-line2" aria-label="상세 주소" />
            </div>
          </section>

          <!-- 결제 수단 (토스 위젯) -->
          <section class="checkout__section" aria-label="결제 수단">
            <h2 class="checkout__section-title">결제 수단</h2>
            <div id="payment-method"></div>
            <div id="agreement"></div>
          </section>
        </div>

        <!-- 결제 요약 -->
        <aside class="checkout__summary">
          <dl class="checkout__summary-list">
            <div class="checkout__summary-row"><dt>상품 금액</dt><dd id="s-items"></dd></div>
            <div class="checkout__summary-row"><dt>배송비</dt><dd id="s-shipping"></dd></div>
            <div class="checkout__summary-row checkout__summary-row--total"><dt>총 결제 금액</dt><dd id="s-total"></dd></div>
          </dl>
          <div id="payMsg" class="checkout__msg" role="alert"></div>
          <button type="button" id="payBtn" class="checkout__pay-btn" disabled>결제하기</button>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { products } from '../data/products';
  import { SHIPPING_FEE } from '../data/shipping';
  import { MAX_QTY } from '../data/order';
  import { $, won } from '../lib/dom';

  const input = (id: string) => ($(id) as HTMLInputElement);
  const CLIENT_KEY = import.meta.env.PUBLIC_TOSS_CLIENT_KEY as string | undefined;

  type OrderItem = { productSku: string; productName: string; price: number; quantity: number };
  let items: OrderItem[] = [];
  let me: { userId: string; name: string; email: string; phone: string; postcode: string; address: string; addressDetail: string };
  // 토스 위젯 SDK 인스턴스 (스크립트 로드 실패·키 미설정 시 null)
  let widgets: any = null;
  // 재결제 모드(?orderId=) — 기존 PENDING 주문을 다시 결제. 주문 생성 없이 위젯만 호출
  let repay: { orderId: string; totalPrice: number } | null = null;
  let shippingFee = SHIPPING_FEE;
  // 장바구니-결제 모드에서 주문에 담긴 cart_id — 결제 완료 후 이 항목만 장바구니에서 정리한다.
  // (바로구매·재결제는 비어 있어 장바구니를 건드리지 않음)
  let cartItemIds: string[] = [];

  function fail(message: string) {
    const el = $('pageMsg');
    el.textContent = message;
    el.hidden = false;
    $('loading').style.display = 'none';
  }

  const itemsTotal = () => items.reduce((sum, i) => sum + i.price * i.quantity, 0);
  // 결제 총액 — 재결제 모드는 주문 시점 서버 확정값 사용 (배송비 정책이 바뀌어도 주문 금액 보존)
  const grandTotal = () => (repay ? repay.totalPrice : itemsTotal() + shippingFee);
  const orderName = () =>
    items.length > 1 ? `${items[0].productName} 외 ${items.length - 1}건` : items[0]?.productName ?? '주문';

  function renderItems() {
    const list = $('itemList');
    list.innerHTML = '';
    for (const it of items) {
      const li = document.createElement('li');
      li.className = 'checkout__item';
      const name = document.createElement('span');
      name.textContent = `${it.productName} × ${it.quantity}`;
      const price = document.createElement('span');
      price.className = 'checkout__item-price';
      price.textContent = won(it.price * it.quantity);
      li.append(name, price);
      list.appendChild(li);
    }
    $('s-items').textContent = won(itemsTotal());
    $('s-shipping').textContent = won(shippingFee);
    $('s-total').textContent = won(grandTotal());
  }

  /* ── 주문 상품 구성 — ?orderId=(재결제) / ?sku=&qty=(바로 구매) / 장바구니(판매 중 항목) ── */
  async function loadItems(): Promise<string | null> {
    const params = new URLSearchParams(location.search);

    // 재결제 — 기존 PENDING 주문을 불러와 품목·배송지 고정, 위젯만 다시 호출
    const orderId = params.get('orderId');
    if (orderId) {
      const res = await fetch(`/api/v1/orders/${encodeURIComponent(orderId)}`).catch(() => null);
      if (!res?.ok) return '주문을 불러오지 못했습니다. 주문 내역에서 다시 시도해 주세요.';
      const order = await res.json();
      if (order.status !== 'PENDING') return '결제 가능한 주문이 아닙니다. 주문 내역을 확인해 주세요.';
      items = order.items.map((i: { productSku: string; productName: string; unitPrice: number; quantity: number }) => ({
        productSku: i.productSku, productName: i.productName, price: i.unitPrice, quantity: i.quantity,
      }));
      repay = { orderId: order.orderId, totalPrice: order.totalPrice };
      shippingFee = order.shippingFee ?? order.totalPrice - itemsTotal(); // 주문 시점 배송비(서버 반환값)
      // 배송지는 주문 스냅샷 고정 (수정하려면 주문 취소 후 재주문)
      input('f-name').value = order.receiverName;
      input('f-phone').value = order.receiverPhone;
      input('f-postcode').value = order.shippingPostcode;
      input('f-address').value = order.shippingAddress;
      input('f-addressDetail').value = order.shippingAddressDetail ?? '';
      for (const id of ['f-name', 'f-phone', 'f-addressDetail']) input(id).readOnly = true;
      ($('zipBtn') as HTMLButtonElement).disabled = true;
      return null;
    }

    const sku = params.get('sku');
    if (sku) {
      const product = products.find((p) => p.id === sku);
      if (!product || product.comingSoon || product.price <= 0) return '구매할 수 없는 제품입니다.';
      const qty = Math.min(Math.max(parseInt(params.get('qty') ?? '1', 10) || 1, 1), MAX_QTY);
      items = [{ productSku: product.id, productName: product.name, price: product.price, quantity: qty }];
      return null;
    }
    const res = await fetch('/api/v1/cart_items').catch(() => null);
    if (!res?.ok) return '장바구니를 불러오지 못했습니다.';
    const cart = (await res.json()).items as (OrderItem & { cartId: string; isActive: boolean })[];
    const active = cart.filter((i) => i.isActive);
    items = active;
    if (!items.length) return '주문할 상품이 없습니다. 장바구니를 확인해 주세요.';
    cartItemIds = active.map((i) => i.cartId);
    return null;
  }

  /* ── 카카오 우편번호 ── */
  $('zipBtn').addEventListener('click', () => {
    const daum = (window as any).daum;
    if (!daum?.Postcode) { alert('주소 검색을 불러오지 못했습니다. 새로고침 후 다시 시도해 주세요.'); return; }
    new daum.Postcode({
      oncomplete: (data: { zonecode: string; roadAddress: string; jibunAddress: string }) => {
        input('f-postcode').value = data.zonecode;
        input('f-address').value = data.roadAddress || data.jibunAddress;
        input('f-addressDetail').focus();
      },
    }).open();
  });

  /* ── 토스 결제위젯 초기화 ── */
  async function initWidgets() {
    const TossPayments = (window as any).TossPayments;
    if (!CLIENT_KEY || !TossPayments) {
      $('payMsg').textContent = '결제 모듈을 불러오지 못했습니다. 새로고침 후에도 반복되면 고객센터로 문의해 주세요.';
      return;
    }
    const toss = TossPayments(CLIENT_KEY);
    widgets = toss.widgets({ customerKey: me.userId });
    await widgets.setAmount({ currency: 'KRW', value: grandTotal() });
    await Promise.all([
      widgets.renderPaymentMethods({ selector: '#payment-method', variantKey: 'DEFAULT' }),
      widgets.renderAgreement({ selector: '#agreement', variantKey: 'AGREEMENT' }),
    ]);
    ($('payBtn') as HTMLButtonElement).disabled = false;
  }

  /* ── 결제하기 — 서버 주문 생성(금액 재계산) 후 위젯 결제창 호출.
       재결제 모드는 주문 생성 없이 기존 orderId·확정 금액으로 바로 호출 ── */
  $('payBtn').addEventListener('click', async () => {
    const msg = $('payMsg');
    msg.textContent = '';
    if (!widgets) { msg.textContent = '결제 모듈이 준비되지 않았습니다.'; return; }

    const btn = $('payBtn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      let orderId: string;
      let name: string;
      let amount: number;

      if (repay) {
        ({ orderId } = repay);
        name = orderName();
        amount = repay.totalPrice;
      } else {
        const receiverName = input('f-name').value.trim();
        const receiverPhone = input('f-phone').value.trim();
        const shippingPostcode = input('f-postcode').value.trim();
        const shippingAddress = input('f-address').value.trim();
        const shippingAddressDetail = input('f-addressDetail').value.trim();
        if (!receiverName || !receiverPhone) { msg.textContent = '수령인과 연락처를 입력해 주세요.'; return; }
        if (!/^\d{5}$/.test(shippingPostcode) || !shippingAddress) { msg.textContent = '주소 검색으로 배송지를 입력해 주세요.'; return; }

        const res = await fetch('/api/v1/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: items.map((i) => ({ productSku: i.productSku, quantity: i.quantity })),
            receiverName, receiverPhone, shippingPostcode, shippingAddress, shippingAddressDetail,
          }),
        });
        const json = await res.json().catch(() => null);
        if (res.status === 401) { location.href = `/login?redirect=${encodeURIComponent('/checkout' + location.search)}`; return; }
        if (!res.ok || !json?.orderId) { msg.textContent = json?.error ?? '주문을 생성하지 못했습니다.'; return; }
        orderId = json.orderId;
        name = json.orderName;
        amount = json.totalPrice; // 금액은 서버 재계산 값이 기준
      }

      // 결제 완료 후 정리할 cart_id를 successUrl 리다이렉트 뒤에도 쓰도록 보관 (같은 탭 sessionStorage).
      // orderId에 묶어 저장 — 이전 결제를 취소하고 다른 주문을 결제할 때 옛 값으로 장바구니가 지워지지 않도록.
      // 바로구매·재결제는 cartItemIds가 비어 저장 대신 옛 값을 제거한다.
      if (cartItemIds.length) {
        sessionStorage.setItem('rb-cart-clear', JSON.stringify({ orderId, ids: cartItemIds }));
      } else {
        sessionStorage.removeItem('rb-cart-clear');
      }

      await widgets.setAmount({ currency: 'KRW', value: amount });
      await widgets.requestPayment({
        orderId,
        orderName: name,
        successUrl: `${location.origin}/order/success`,
        failUrl: `${location.origin}/order/fail?orderId=${orderId}`,
        customerName: me.name,
        customerEmail: me.email,
      });
    } catch (err: any) {
      // 사용자가 결제창을 닫으면 requestPayment가 reject — 주문(PENDING)은 24h 정리 배치가 처리
      if (err?.code !== 'USER_CANCEL') {
        console.error(err);
        msg.textContent = err?.message ?? '결제를 시작하지 못했습니다.';
      }
    } finally {
      btn.disabled = false;
    }
  });

  /* ── 초기화 ── */
  (async () => {
    const meRes = await fetch('/api/v1/users/me').catch(() => null);
    if (!meRes) { fail('페이지를 불러오지 못했습니다. 새로고침해 주세요.'); return; }
    if (meRes.status === 401) {
      location.href = `/login?redirect=${encodeURIComponent('/checkout' + location.search)}`;
      return;
    }
    if (!meRes.ok) { fail('회원 정보를 불러오지 못했습니다. 새로고침해 주세요.'); return; }
    me = await meRes.json();

    const itemsError = await loadItems();
    if (itemsError) { fail(itemsError); return; }

    // 배송지 기본값 = 회원 정보 (수정 가능 — 주문에는 스냅샷 저장).
    // 재결제 모드는 loadItems가 주문 스냅샷으로 채우므로 덮어쓰지 않음
    if (!repay) {
      input('f-name').value = me.name ?? '';
      input('f-phone').value = me.phone ?? '';
      input('f-postcode').value = me.postcode ?? '';
      input('f-address').value = me.address ?? '';
      input('f-addressDetail').value = me.addressDetail ?? '';
    }

    renderItems();
    $('loading').style.display = 'none';
    ($('content') as HTMLElement).hidden = false;
    await initWidgets();
  })();
</script>
