---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/auth.css';
---
<BaseLayout
  title="비밀번호 재설정 - RoboSEasy | 로보시지"
  description="로보시지 계정 비밀번호 재설정"
  path="/reset-password"
  lockTheme="light"
  shopNav
>
  <meta name="robots" content="noindex" slot="head" />

  <main class="auth">
    <div class="auth__card">
      <!-- 1단계: 재설정 메일 요청 (토큰 없이 접근) -->
      <div id="requestWrap">
        <div class="auth__eyebrow">Reset Password</div>
        <h1 class="auth__title">비밀번호 재설정</h1>
        <p class="auth__desc">가입한 이메일을 입력하면 재설정 링크를 보내드립니다.</p>

        <form id="requestForm" class="auth__form" novalidate>
          <div id="requestMsg" class="auth__msg" role="alert"></div>
          <div class="auth__field">
            <label class="auth__label auth__label--req" for="r-email">이메일</label>
            <input id="r-email" class="auth__input" type="email" autocomplete="email" placeholder="you@example.com" required />
          </div>
          <button type="submit" id="requestBtn" class="auth__submit">재설정 메일 받기</button>
        </form>

        <p class="auth__footer"><a href="/login">로그인 페이지로</a></p>
      </div>

      <!-- 2단계: 새 비밀번호 설정 (메일 링크로 접근 — 복구 토큰 보유) -->
      <div id="setWrap" style="display:none;">
        <div class="auth__eyebrow">Reset Password</div>
        <h1 class="auth__title">새 비밀번호 설정</h1>
        <p class="auth__desc">사용할 새 비밀번호를 입력해 주세요.</p>

        <form id="setForm" class="auth__form" novalidate>
          <div id="setMsg" class="auth__msg" role="alert"></div>
          <div class="auth__field">
            <label class="auth__label auth__label--req" for="s-password">새 비밀번호</label>
            <input id="s-password" class="auth__input" type="password" autocomplete="new-password" placeholder="8자 이상" required />
          </div>
          <div class="auth__field">
            <label class="auth__label auth__label--req" for="s-password2">새 비밀번호 확인</label>
            <input id="s-password2" class="auth__input" type="password" autocomplete="new-password" placeholder="비밀번호 재입력" required />
          </div>
          <button type="submit" id="setBtn" class="auth__submit">비밀번호 변경</button>
        </form>
      </div>

      <!-- 완료 -->
      <div id="doneWrap" class="auth__done">
        <div class="auth__done-icon">🔑</div>
        <h2 class="auth__done-title">비밀번호가 변경되었습니다</h2>
        <p class="auth__done-desc">새 비밀번호로 다시 로그인해 주세요.</p>
        <p class="auth__footer"><a href="/login">로그인 페이지로</a></p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const val = (id: string) => ($(id) as HTMLInputElement).value;
  const showMsg = (id: string, type: 'error' | 'info', text: string) => {
    $(id).className = `auth__msg auth__msg--${type}`;
    $(id).textContent = text;
  };

  /* 메일 링크로 오면 Supabase가 hash에 복구 토큰을 실어 보냄 (type=recovery).
     토큰은 메모리에만 보관하고 URL에서 즉시 제거 */
  const hash = new URLSearchParams(location.hash.slice(1));
  const recoveryToken = hash.get('type') === 'recovery' ? hash.get('access_token') : null;
  const hashError = hash.get('error_description') || hash.get('error');
  history.replaceState(null, '', location.pathname);

  if (recoveryToken) {
    $('requestWrap').style.display = 'none';
    $('setWrap').style.display = 'block';
  } else if (hashError) {
    showMsg('requestMsg', 'error', '링크가 만료되었거나 유효하지 않습니다. 재설정 메일을 다시 요청해 주세요.');
  }

  /* ── 1단계: 재설정 메일 요청 ── */
  $('requestForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = val('r-email').trim();
    if (!email) { showMsg('requestMsg', 'error', '이메일을 입력해 주세요.'); return; }

    const btn = $('requestBtn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '발송 중...';
    try {
      const res = await fetch('/api/v1/users/reset-password-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const json = await res.json();
      if (!res.ok) { showMsg('requestMsg', 'error', json.error ?? '요청에 실패했습니다.'); return; }
      showMsg('requestMsg', 'info', '가입된 이메일이라면 재설정 링크를 발송했습니다. 받은 편지함(스팸함 포함)을 확인해 주세요.');
    } catch {
      showMsg('requestMsg', 'error', '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.');
    } finally {
      btn.disabled = false; btn.textContent = '재설정 메일 받기';
    }
  });

  /* ── 2단계: 새 비밀번호 설정 ── */
  $('setForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = val('s-password');
    if (password.length < 8) { showMsg('setMsg', 'error', '비밀번호는 8자 이상이어야 합니다.'); return; }
    if (password !== val('s-password2')) { showMsg('setMsg', 'error', '비밀번호가 일치하지 않습니다.'); return; }

    const btn = $('setBtn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '변경 중...';
    try {
      const res = await fetch('/api/v1/users/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accessToken: recoveryToken, newPassword: password }),
      });
      const json = await res.json();
      if (!res.ok) { showMsg('setMsg', 'error', json.error ?? '비밀번호 변경에 실패했습니다.'); return; }
      $('setWrap').style.display = 'none';
      ($('doneWrap') as HTMLElement).style.display = 'block';
    } catch {
      showMsg('setMsg', 'error', '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.');
    } finally {
      btn.disabled = false; btn.textContent = '비밀번호 변경';
    }
  });
</script>
