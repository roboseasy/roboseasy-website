---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/documents.css';

const title = 'Documentation - RoboSEasy | 로보시지';
const description = '제품별 상세 문서를 확인하세요. Physical Labs, LeRobot Library, A-Ba(SO-ARM101), Dual A-Ba(Dual SO-ARM), A-Go(LeKiwi) 문서 제공';
---
<BaseLayout title={title} description={description} path="/documents">
  <section class="page-intro">
    <div class="page-intro__container">
      <h1 class="page-intro__heading">Documentation</h1>
      <p class="page-intro__description">제품별 상세 문서를 확인하세요</p>
    </div>
  </section>

  <section class="documents">
    <div class="docs-grid">
      <div class="doc-card">
        <a href="/docs/physical-labs" class="doc-card__image-wrap">
          <img class="doc-card__image" src="/img/documents_img/physical-labs.webp" alt="Physical Labs" />
        </a>
        <div class="doc-card__body">
          <h3 class="doc-card__title">Physical Labs</h3>
          <p class="doc-card__description">
            로봇 학습 · 제어 통합 데스크톱 앱 Physical Labs 사용 설명서.<br />
            모터 셋업부터 텔레오퍼레이션 · 데이터 수집 · 훈련 · 추론까지 안내합니다.
          </p>
          <a href="/docs/physical-labs" class="doc-card__button">더 알아보기</a>
        </div>
      </div>

      <div class="doc-card">
        <a href="/docs/lerobot-library" class="doc-card__image-wrap">
          <img class="doc-card__image" src="/img/documents_img/lerobot-library.webp" alt="LeRobot Library" />
        </a>
        <div class="doc-card__body">
          <h3 class="doc-card__title">LeRobot Library</h3>
          <p class="doc-card__description">
            HuggingFace LeRobot 라이브러리 사용 가이드.<br />
            로봇 학습 알고리즘 및 데이터셋 활용 방법을 제공합니다.
          </p>
          <a href="/docs/lerobot-library" class="doc-card__button">더 알아보기</a>
        </div>
      </div>

      <div class="doc-card">
        <a href="/docs/a-ba" class="doc-card__image-wrap">
          <img class="doc-card__image" src="/img/documents_img/lerobot-so-arm.webp" alt="A-Ba(SO-ARM101)" />
        </a>
        <div class="doc-card__body">
          <h3 class="doc-card__title">A-Ba(SO-ARM101)</h3>
          <p class="doc-card__description">
            오픈소스 로봇 팔 A-Ba(SO-ARM101) 조립 및 제어 가이드.<br />
            하드웨어 조립부터 소프트웨어 설정까지 상세 안내합니다.
          </p>
          <a href="/docs/a-ba" class="doc-card__button">더 알아보기</a>
        </div>
      </div>

      <div class="doc-card">
        <a href="/docs/dual-a-ba" class="doc-card__image-wrap">
          <img class="doc-card__image" src="/img/documents_img/xlerobot.webp" alt="Dual A-Ba(Dual SO-ARM)" />
        </a>
        <div class="doc-card__body">
          <h3 class="doc-card__title">Dual A-Ba(Dual SO-ARM)</h3>
          <p class="doc-card__description">
            확장형 로봇 플랫폼 Dual A-Ba(Dual SO-ARM) 활용 가이드.<br />
            다양한 센서와 액추에이터를 연결하여 커스터마이징 가능합니다.
          </p>
          <a href="/docs/dual-a-ba" class="doc-card__button">더 알아보기</a>
        </div>
      </div>

      <div class="doc-card">
        <a href="/docs/a-go" class="doc-card__image-wrap">
          <img class="doc-card__image" src="/img/documents_img/lekiwi.webp" alt="A-Go(LeKiwi)" />
        </a>
        <div class="doc-card__body">
          <h3 class="doc-card__title">A-Go(LeKiwi)</h3>
          <p class="doc-card__description">
            ROS 2 모바일 로봇 A-Go(LeKiwi) 사용 설명서.<br />
            웹 대시보드 · 지도 작성 · 자율 주행 · Physical Labs 연동을 안내합니다.
          </p>
          <a href="/docs/a-go" class="doc-card__button">더 알아보기</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
