# netlify.app → roboseasy.ai 전체 도메인 통합 (SEO 색인 이전)
https://roboseasy.netlify.app/*   https://roboseasy.ai/:splat   301!

# Astro 라우트가 모든 새 URL을 직접 서빙하므로 pretty URL 매핑은 더 이상 필요 없음.
# 아래는 Astro 마이그레이션 이전 외부에 노출된 URL의 SEO 호환을 위한 영구 리다이렉트.

# 옛 docsify 문서 진입 URL → 새 docs 라우트
/docs-lerobot-library.html        /docs/lerobot-library        301
/docs-lerobot-so-arm.html         /docs/a-ba                   301
/docs-xlerobot.html               /docs/dual-a-ba              301
/docs-lekiwi.html                 /docs/a-go                   301

# 제품 브랜드명 변경(SO-ARM101→A-Ba / XLeRobot→Dual A-Ba / LeKiwi→A-Go)에 따른 docs slug 이전.
# 하위 문서까지 함께 옮겨졌으므로 :splat으로 경로 뒤쪽을 보존한다.
/docs/lerobot-so-arm              /docs/a-ba                   301
/docs/lerobot-so-arm/*            /docs/a-ba/:splat            301
/docs/xlerobot                    /docs/dual-a-ba              301
/docs/xlerobot/*                  /docs/dual-a-ba/:splat       301
/docs/lekiwi                      /docs/a-go                   301
/docs/lekiwi/*                    /docs/a-go/:splat            301

# 제품 sku 변경(so-arm101-max→a-ba-max / lekiwi→a-go)에 따른 제품 상세 URL 이전
/products/so-arm101-max           /products/a-ba-max           301
/products/lekiwi                  /products/a-go               301

# 옛 SHOP 페이지(디자인 1안) → PRODUCTS 통합
